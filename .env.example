# Copy to .env and fill in. .env is gitignored; this example is not.
#
#   cp .env.example .env && chmod 600 .env
#
# Everything else — tool versions, image pins, the browserless token — lives in
# nixie.yml. Only secrets and per-deployment identity belong here.

# Lets you run `docker compose up -d` without `-f nixie.yml` every time.
COMPOSE_FILE=nixie.yml

# ---- Agent and commit identity -------------------------------------------
# The agent's persona name. Sets Identity.AgentName in netclaw.json and is
# substituted into identity/SOUL.md on first run. Persona only — the client
# workspace directory and the external skill source keep their own names.
AGENT_NAME=Nixie

# Author of every commit the agent makes. Required, not defaulted: these end up
# in immutable git history, so a silently-wrong default is worse than a startup
# error. Seeded into netclaw/gitconfig, which lives in the persistent bind mount
# because /home/netclaw is plain container layer and ~/.gitconfig would be lost
# on every recreate.
#
# Note this is separate from the account that authenticates: commits are
# authored as GIT_USER_NAME/GIT_USER_EMAIL, while pushes use GH_TOKEN's account.
# For GitHub to show "Verified", GIT_USER_EMAIL must be registered on the
# account that owns the signing key.
GIT_USER_NAME=Nixie
GIT_USER_EMAIL=nixie@example.com

# ---- Workspaces ------------------------------------------------------------
# Repos cloned into the agent's workspace on first run. netclaw/workspaces/ is
# gitignored, so without this a fresh clone of nixie has an empty workspace and
# any ExternalSkills source pointing into it silently resolves to nothing.
#
# Whitespace-separated list. Each entry is either:
#     <url>            cloned to $WORKSPACE_ROOT/<repo-name-without-.git>
#     <url>=<subdir>   cloned to $WORKSPACE_ROOT/<subdir>
# <subdir> may contain slashes. SSH URLs work too — splitting is on '=', and
# scp-style URLs (git@host:org/repo.git) use ':'.
#
# Clone-only: existing checkouts are never pulled or reset, so agent work in
# progress is safe. Each repo is best-effort — one unreachable remote does not
# block startup or the other repos.
#
# Multi-line example (quote the whole value):
#   WORKSPACE_REPOS="https://github.com/acme/skills.git \
#                    git@github.com:acme/runbooks.git=ops/runbooks"
#
# WORKSPACE_ROOT defaults to netclaw's own projects directory and rarely needs
# setting. To host several clients from one deployment, either point it at a
# per-client directory or use the "=<subdir>" form per entry.
# WORKSPACE_ROOT=/home/netclaw/.netclaw/workspaces
#
# Left commented so a fresh clone starts with an empty workspace rather than
# trying to clone a placeholder repo and warning when it does not exist.
# Uncomment and list your own repos.
# WORKSPACE_REPOS=git@github.com:acme/skills.git

# Extra flags passed to every `git clone` above. Defaults to --filter=blob:none,
# a partial clone: full commit history and graph, file contents fetched lazily.
# This matters because netclaw does not start until config-init has finished
# cloning (service_completed_successfully), so cloning blocks startup.
#
# Measured on one real deployment, so you can judge whether it is worth it:
#
#   repo            full clone      partial clone
#   core            4s /  41MB         7s /  33MB    <- slightly WORSE
#   web           118s / 1.9GB        41s / 1.1GB    <- clearly better
#
# The win is not uniform. For small repos the extra round trip to fetch HEAD's
# blobs makes partial marginally slower. It pays off on large-history repos,
# and since one such repo dominates the total, the default is worth keeping.
# If your workspace is all small repos, plain full clones are simpler.
#
# Preferred over --depth because history-based tooling keeps working: git log,
# git blame and git bisect behave normally. The trade-off is that reading old
# file contents fetches on demand, so it needs network and is slower first time.
#
# Commented out because --filter=blob:none is already the default in nixie.yml.
# Uncomment only to override it — an explicit empty value means plain full
# clones, e.g. for an air-gapped run:
#   WORKSPACE_CLONE_ARGS=
# WORKSPACE_CLONE_ARGS=--filter=blob:none

# ---- Sidecars ---------------------------------------------------------------
# Shared secret for the headless-Chromium sidecar. browserless rejects any
# connection whose ?token= does not match. Not a vendor credential — you issue
# it. Leave empty and setup.sh generates one; it is deliberately not shipped
# with a value so that no two forks of this template share a token.
#
#   openssl rand -hex 24
BROWSERLESS_TOKEN=

# Cookie/HMAC signing secret for the SearXNG sidecar. Not a vendor credential —
# you issue it, and nothing outside the compose network ever sees it. SearXNG
# refuses to start while its secret is still the template default, so one must
# exist. Leave empty and setup.sh generates it; it is deliberately not shipped
# with a value so that no two forks of this template share a secret.
#
#   openssl rand -hex 24
SEARXNG_SECRET=

# ---- Management UI ----------------------------------------------------------
# Host bind for the unofficial netclaw-ui sidecar (see README). The UI has no
# login and talks to the daemon with Operator rights, so the default publishes
# it on host loopback only. Change the port half freely; widen the address
# half only if something in front of it authenticates. Commented out because
# the nixie.yml default is already right for a single-host deployment.
# NETCLAW_UI_BIND=127.0.0.1:5198

# GitHub personal access token.
# Used by three things: the `gh` CLI, git's credential helper for HTTPS clones
# (via `gh auth git-credential`), and github-mcp-server, which receives it as
# GITHUB_PERSONAL_ACCESS_TOKEN by inheriting the daemon's environment.
# `netclaw mcp add --env` does NOT persist env vars, so this is the only path.
#
# Scopes: repo (+ read:org for private org repos, workflow to touch Actions).
GH_TOKEN=github_pat_xxxxxxxxxx

# Basename of an SSH private key inside ./ssh, used to sign commits.
# Leave empty to disable signing entirely.
#
# The matching public key must be registered on GitHub TWICE — once as an
# Authentication key and once as a Signing key; they are separate entries and
# adding only the first leaves commits unverified. The signing email
# (GIT_USER_EMAIL above) must also be on the GitHub account for the
# "Verified" badge to appear.
#
# Generate with:
#   ssh-keygen -t ed25519 -a 100 -N '' -C 'nixie@example.com' -f ssh/id_ed25519_nixie
# config-init locks private keys to uid 1654 and leaves the public material
# readable, so git on the host can still track ssh/config and known_hosts.
GIT_USER_KEY=id_ed25519_nixie

# Optional: force tools-init to re-copy /tools without changing a version.
# Normally unnecessary — the build stamp hashes both the version args and the
# build recipe, so any real change re-provisions on its own.
# TOOLS_REVISION=
